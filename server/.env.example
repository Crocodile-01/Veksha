# =============================================================================
# VEKSHA Environment Configuration Template
# Copy this file to server/.env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase / Firestore Configuration
# -----------------------------------------------------------------------------
# Option A: Local file path (Windows paths or relative paths)
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/veksha-health-monitor-firebase-adminsdk-fbsvc-2df14b18ff.json

# Option B: Cloud deployment raw JSON string (Render / Railway / Fly.io / Docker)
# If FIREBASE_SERVICE_ACCOUNT_JSON is set, it overrides FIREBASE_SERVICE_ACCOUNT_PATH.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": ...}

# Firebase project ID
FIREBASE_PROJECT_ID=veksha-health-monitor

# Firestore collection names
FIREBASE_READINGS_COLLECTION=health_readings
FIREBASE_SOS_COLLECTION=sos_events

# Set to "false" to disable Firebase write-through for offline dev
FIREBASE_ENABLED=true

# -----------------------------------------------------------------------------
# 2. Abnormal Vitals Alert Thresholds (Clinician-Configurable)
# -----------------------------------------------------------------------------
# Heart rate bounds (BPM)
ALERT_HR_MIN=50.0
ALERT_HR_MAX=120.0

# Blood oxygen minimum threshold (%)
ALERT_SPO2_MIN=90.0

# Number of consecutive abnormal frames required to confirm alert (anti-spike filter)
ALERT_SUSTAINED_COUNT=3

# Alert cooldown to prevent duplicate alert spam (in seconds, default 5 mins)
ALERT_COOLDOWN_SECONDS=300

# Rate limit cooldown for manual SOS button (in seconds)
SOS_COOLDOWN_SECONDS=15

# -----------------------------------------------------------------------------
# 3. Emergency SMS Notifications (India DLT / MSG91 Integration)
# -----------------------------------------------------------------------------
# Enable or disable SMS dispatch ("true" to activate)
SMS_ENABLED=false

# Provider type: "msg91" for live Indian SMS, or "mock" for local testing
SMS_PROVIDER=mock

# MSG91 Authentication Key (from MSG91 dashboard)
MSG91_AUTH_KEY=your_msg91_auth_key_here

# Approved DLT Template ID (Flow ID from MSG91 dashboard)
MSG91_TEMPLATE_ID=your_approved_flow_template_id

# Registered 6-character DLT Header / Sender ID (e.g. VEKSHA)
MSG91_SENDER_ID=VEKSHA

# Comma-separated list of emergency contact numbers (with country code)
# Example: 919876543210, 919876543211
EMERGENCY_CONTACTS=919876543210

# Cooldown between SMS alerts in seconds to prevent wallet depletion
SMS_COOLDOWN_SECONDS=300

# -----------------------------------------------------------------------------
# 4. Remote Deployment & Security
# -----------------------------------------------------------------------------
# Allowed CORS origins for dashboard access
# Set to "*" for open dev, or comma-separated URLs for production:
# Example: https://veksha-dashboard.vercel.app,http://localhost:8000
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# 5. Android SMS Gateway (FCM-based)
# -----------------------------------------------------------------------------
# Set to "true" to enable push notifications to the Android SMS Gateway
ANDROID_GATEWAY_ENABLED=true
FCM_ENABLED=true

# Shared secret key between Android app and backend to authorize gateway registration and status reports
GATEWAY_API_KEY=generate-a-random-secret-key-and-put-here

